# Login: the `sessionid` cookie of a logged-in instagram.com browser session
# (see "Logging in" in README.md). Treat it like a password.
IG_SESSION_ID=your_sessionid_cookie

# Optional: if set, a session for a different account is refused
# IG_USERNAME=your_instagram_username

# Password login is currently unavailable (Instagram changed its login flow)
# IG_PASSWORD=your_instagram_password

# Optional: where to store the saved session (default: ~/.config/mcp-instagram)
# IG_SESSION_DIR=/path/to/dir

# Optional: JSON overrides for like/comment/follow/login rate limits
# IG_RATE_LIMITS={"like":{"perHour":100}}
