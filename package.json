{
  "name": "mcp-instagram",
  "version": "0.0.6",
  "description": "MCP server for Instagram",
  "mcpName": "io.github.anand-kamble/mcp-instagram",
  "type": "module",
  "main": "build/server.js",
  "bin": {
    "mcp-instagram": "./bin/insta-mcp.js"
  },
  "files": [
    "build/",
    "bin/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/server.js",
    "dev": "tsc --watch",
    "pretest": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol"
  ],
  "author": {
    "name": "Anand Kamble",
    "email": "amkamble@icloud.com",
    "url": "https://anand-kamble.github.io/"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/anand-kamble/mcp-instagram.git"
  },
  "bugs": {
    "url": "https://github.com/anand-kamble/mcp-instagram/issues"
  },
  "homepage": "https://github.com/anand-kamble/mcp-instagram#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "instagram-private-api": "1.46.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
